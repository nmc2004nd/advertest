{
  "$defs": {
    "Role": {
      "enum": [
        "engineer",
        "reviewer",
        "admin"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "full_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Full Name",
      "type": "string"
    },
    "email": {
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "title": "Email",
      "type": "string"
    },
    "organization": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organization"
    },
    "requested_role": {
      "$ref": "#/$defs/Role"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "password": {
      "maxLength": 256,
      "minLength": 10,
      "title": "Password",
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "email",
    "requested_role",
    "reason",
    "password"
  ],
  "title": "AccessRequest",
  "type": "object"
}
