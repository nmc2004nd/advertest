{
  "$defs": {
    "GradientCheck": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lý do khi passed = false",
          "title": "Details"
        }
      },
      "required": [
        "passed",
        "checked_at"
      ],
      "title": "GradientCheck",
      "type": "object"
    },
    "ModelCheckResult": {
      "additionalProperties": false,
      "description": "Kết quả job model_check: nạp model, so sha256, inference trên fixture, số class, kiểm\ngradient (chỉ torchvision).",
      "properties": {
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lý do khi passed = false",
          "title": "Details"
        },
        "gradient_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/GradientCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "null với onnx (không hỗ trợ gradient) hoặc khi dừng trước bước này"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "worker_target_id": {
          "format": "uuid",
          "title": "Worker Target Id",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "gradient_check",
        "checked_at",
        "worker_target_id"
      ],
      "title": "ModelCheckResult",
      "type": "object"
    },
    "ModelStatus": {
      "enum": [
        "checking",
        "check_failed",
        "ready"
      ],
      "title": "ModelStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "ID của model version",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "framework": {
      "description": "Ví dụ ultralytics; hiển thị ở ô kiến trúc của wizard",
      "title": "Framework",
      "type": "string"
    },
    "weights_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Weights Sha256",
      "type": "string"
    },
    "class_names": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Class Names",
      "type": "array"
    },
    "input_size": {
      "exclusiveMinimum": 0,
      "title": "Input Size",
      "type": "integer"
    },
    "supports_gradients": {
      "title": "Supports Gradients",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ModelStatus",
      "default": "ready",
      "description": "Phase R2: chỉ model ready được dùng trong experiment và thử nhanh"
    },
    "check": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCheckResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Kết quả job model_check gần nhất; null với model đăng ký qua CLI"
    }
  },
  "required": [
    "id",
    "name",
    "framework",
    "weights_sha256",
    "class_names",
    "input_size",
    "supports_gradients",
    "created_at"
  ],
  "title": "ModelSummary",
  "type": "object"
}
