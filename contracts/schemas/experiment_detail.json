{
  "$defs": {
    "AttackConfig": {
      "additionalProperties": false,
      "description": "Một attack trong experiment.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "spec_sha256": {
          "description": "Chốt đúng version spec",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Sha256",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RunMode"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "training_slice_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 6: bắt buộc khi spec có requires_training; không giao với slice đánh giá",
          "title": "Training Slice Id"
        }
      },
      "required": [
        "attack_spec_id",
        "spec_sha256",
        "mode",
        "seed"
      ],
      "title": "AttackConfig",
      "type": "object"
    },
    "AttackKind": {
      "enum": [
        "attack",
        "corruption",
        "occlusion"
      ],
      "title": "AttackKind",
      "type": "string"
    },
    "AttackRankingEntry": {
      "additionalProperties": false,
      "description": "Một attack trong bảng xếp hạng (Phase 6, `ml_core/metrics/ranking.py`).\n\nĐiểm của đường cong: (level / primary_param.max, relative_drop), thêm (0, 0) ở đầu; level bị\n`early_stop` lấy relative_drop của run kích hoạt. Diện tích tính đến `coverage`, không ngoại\nsuy.",
      "properties": {
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttackKind"
        },
        "auc_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Diện tích hình thang; null khi ít hơn 2 điểm (không đủ dữ liệu)",
          "title": "Auc Drop"
        },
        "max_relative_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi không có level nào có metric",
          "title": "Max Relative Drop"
        },
        "levels_evaluated": {
          "description": "Số level có metric",
          "minimum": 0,
          "title": "Levels Evaluated",
          "type": "integer"
        },
        "levels_early_stopped": {
          "description": "Số level bị bỏ qua do dừng sớm",
          "minimum": 0,
          "title": "Levels Early Stopped",
          "type": "integer"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "level / max lớn nhất được tính (có metric hoặc early_stop); null khi không có",
          "title": "Coverage"
        },
        "partial": {
          "description": "Có run stopped_limit hoặc metrics.partial",
          "title": "Partial",
          "type": "boolean"
        }
      },
      "required": [
        "attack_spec_id",
        "name",
        "kind",
        "auc_drop",
        "max_relative_drop",
        "levels_evaluated",
        "levels_early_stopped",
        "coverage",
        "partial"
      ],
      "title": "AttackRankingEntry",
      "type": "object"
    },
    "ComputeKind": {
      "enum": [
        "local",
        "rented"
      ],
      "title": "ComputeKind",
      "type": "string"
    },
    "ComputeTargetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComputeKind"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "ComputeTargetRef",
      "type": "object"
    },
    "EvalScope": {
      "description": "Tập ảnh mà run đánh giá (Phase 7).",
      "enum": [
        "full",
        "subset"
      ],
      "title": "EvalScope",
      "type": "string"
    },
    "ExperimentConfig": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "protocol_id": {
          "format": "uuid",
          "title": "Protocol Id",
          "type": "string"
        },
        "model_version_id": {
          "format": "uuid",
          "title": "Model Version Id",
          "type": "string"
        },
        "slice_id": {
          "format": "uuid",
          "title": "Slice Id",
          "type": "string"
        },
        "class_mapping_id": {
          "format": "uuid",
          "title": "Class Mapping Id",
          "type": "string"
        },
        "compute_target_id": {
          "format": "uuid",
          "title": "Compute Target Id",
          "type": "string"
        },
        "attacks": {
          "items": {
            "$ref": "#/$defs/AttackConfig"
          },
          "minItems": 1,
          "title": "Attacks",
          "type": "array"
        },
        "limit": {
          "$ref": "#/$defs/Limit"
        }
      },
      "required": [
        "protocol_id",
        "model_version_id",
        "slice_id",
        "class_mapping_id",
        "compute_target_id",
        "attacks",
        "limit"
      ],
      "title": "ExperimentConfig",
      "type": "object"
    },
    "ExperimentStatus": {
      "enum": [
        "draft",
        "queued",
        "running",
        "completed",
        "submitted_for_review",
        "in_review",
        "approved",
        "changes_requested",
        "rejected",
        "cancelled"
      ],
      "title": "ExperimentStatus",
      "type": "string"
    },
    "GridConfig": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "early_stop": {
          "description": "Phase 6: bỏ level lớn hơn khi model đã sụp (mAP@0.5 <= 5% mAP sạch)",
          "title": "Early Stop",
          "type": "boolean"
        }
      },
      "required": [
        "levels"
      ],
      "title": "GridConfig",
      "type": "object"
    },
    "Limit": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/LimitKind"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Tiền (budget) hoặc giây (time)",
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Limit",
      "type": "object"
    },
    "LimitKind": {
      "enum": [
        "budget",
        "time"
      ],
      "title": "LimitKind",
      "type": "string"
    },
    "MapPair": {
      "additionalProperties": false,
      "properties": {
        "map50": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50",
          "type": "number"
        },
        "map50_95": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50 95",
          "type": "number"
        }
      },
      "required": [
        "map50",
        "map50_95"
      ],
      "title": "MapPair",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "ID của model version",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "images_done": {
          "minimum": 0,
          "title": "Images Done",
          "type": "integer"
        },
        "images_total": {
          "minimum": 0,
          "title": "Images Total",
          "type": "integer"
        }
      },
      "required": [
        "images_done",
        "images_total"
      ],
      "title": "Progress",
      "type": "object"
    },
    "ProtocolRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProtocolStatus"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "title": "ProtocolRef",
      "type": "object"
    },
    "ProtocolStatus": {
      "enum": [
        "active",
        "retired",
        "dev"
      ],
      "title": "ProtocolStatus",
      "type": "string"
    },
    "RunCounts": {
      "additionalProperties": false,
      "description": "Số run theo từng `RunStatus`.",
      "properties": {
        "queued": {
          "minimum": 0,
          "title": "Queued",
          "type": "integer"
        },
        "running": {
          "minimum": 0,
          "title": "Running",
          "type": "integer"
        },
        "completed": {
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "stopped_limit": {
          "minimum": 0,
          "title": "Stopped Limit",
          "type": "integer"
        },
        "cancelled": {
          "minimum": 0,
          "title": "Cancelled",
          "type": "integer"
        }
      },
      "required": [
        "queued",
        "running",
        "completed",
        "failed",
        "skipped",
        "stopped_limit",
        "cancelled"
      ],
      "title": "RunCounts",
      "type": "object"
    },
    "RunMode": {
      "enum": [
        "grid",
        "search"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "SearchConfig": {
      "additionalProperties": false,
      "description": "Cấu hình tự tìm ngưỡng (Phase 7, requirements.md mục Behaviour).\n\nKiểm tra phụ thuộc spec, slice và mapping (`lo`, `hi` trong dải của spec; `subset_size` không\nquá số ảnh slice; `absolute_drop` không quá mAP sạch; `class_filter` là class đích) ở backend.",
      "properties": {
        "threshold_kind": {
          "$ref": "#/$defs/ThresholdKind"
        },
        "threshold": {
          "description": "relative_drop, attack_success_rate: (0, 1]; absolute_drop: (0, mAP sạch]",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "tol": {
          "description": "Độ rộng khoảng khi dừng chia đôi; wizard mặc định (hi - lo) / 256. Tham số rời rạc chia đôi theo chỉ số nên không dùng tol",
          "exclusiveMinimum": 0,
          "title": "Tol",
          "type": "number"
        },
        "coarse_n": {
          "default": 4,
          "description": "Số level quét thô",
          "maximum": 8,
          "minimum": 3,
          "title": "Coarse N",
          "type": "integer"
        },
        "subset_size": {
          "default": 100,
          "description": "Số ảnh của tập con; wizard cảnh báo khi dưới 20",
          "minimum": 2,
          "title": "Subset Size",
          "type": "integer"
        },
        "class_filter": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Một class đích của mapping; null là mọi class",
          "title": "Class Filter"
        },
        "bootstrap_samples": {
          "default": 200,
          "description": "Số mẫu bootstrap; 0 là không tính khoảng tin cậy",
          "maximum": 1000,
          "minimum": 0,
          "title": "Bootstrap Samples",
          "type": "integer"
        }
      },
      "required": [
        "threshold_kind",
        "threshold",
        "lo",
        "hi",
        "tol"
      ],
      "title": "SearchConfig",
      "type": "object"
    },
    "SearchResult": {
      "additionalProperties": false,
      "description": "Kết quả tìm ngưỡng của một attack (Phase 7).\n\nWorker gửi bản tạm thời sau mỗi điểm (`stage` khác `done`, `status` null) và bản cuối\n(`stage = done`) kèm bootstrap. `bracket` là khoảng hiện tại, kể cả khi dừng giữa chừng.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "experiment_id": {
          "format": "uuid",
          "title": "Experiment Id",
          "type": "string"
        },
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/SearchStage"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi và chỉ khi stage khác done"
        },
        "threshold_kind": {
          "$ref": "#/$defs/ThresholdKind"
        },
        "threshold": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Threshold",
          "type": "number"
        },
        "class_filter": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Class Filter"
        },
        "metric_kind": {
          "description": "map50: mAP@0.5; class_ap50: AP@0.5 của class_filter; asr: ASR mọi object; class_asr: ASR object của class_filter. Suy từ threshold_kind và class_filter",
          "enum": [
            "map50",
            "class_ap50",
            "asr",
            "class_asr"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "breaking_point": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Có khi và chỉ khi status là found hoặc non_monotonic (= bracket[1])",
          "title": "Breaking Point"
        },
        "bracket": {
          "description": "Khoảng hiện tại, kể cả khi dừng giữa chừng",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bracket",
          "type": "array"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Khoảng tin cậy 95% của điểm gãy; null nếu chưa tính bootstrap",
          "title": "Confidence Interval"
        },
        "near_threshold": {
          "description": "Khoảng tin cậy của d(b) có cận dưới < ngưỡng, hoặc của d(a) có cận trên >= ngưỡng; false khi chưa tính bootstrap",
          "title": "Near Threshold",
          "type": "boolean"
        },
        "max_points": {
          "description": "Giới hạn trên số run (ml_core/search/bounds.py)",
          "exclusiveMinimum": 0,
          "title": "Max Points",
          "type": "integer"
        },
        "points_used": {
          "description": "Số điểm đã đánh giá (không gồm synthetic)",
          "minimum": 0,
          "title": "Points Used",
          "type": "integer"
        },
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Có khi và chỉ khi status = failed",
          "title": "Message"
        },
        "trajectory": {
          "items": {
            "$ref": "#/$defs/TrajectoryPoint"
          },
          "title": "Trajectory",
          "type": "array"
        }
      },
      "required": [
        "experiment_id",
        "attack_spec_id",
        "stage",
        "status",
        "threshold_kind",
        "threshold",
        "class_filter",
        "metric_kind",
        "bracket",
        "near_threshold",
        "max_points",
        "points_used",
        "trajectory"
      ],
      "title": "SearchResult",
      "type": "object"
    },
    "SearchStage": {
      "description": "Giai đoạn của một lần tìm ngưỡng (Phase 7, requirements.md mục Thuật toán).",
      "enum": [
        "coarse",
        "bisect_subset",
        "confirm",
        "bisect_full",
        "done"
      ],
      "title": "SearchStage",
      "type": "string"
    },
    "SearchStatus": {
      "enum": [
        "found",
        "not_reached",
        "below_min",
        "stopped_limit",
        "non_monotonic",
        "failed"
      ],
      "title": "SearchStatus",
      "type": "string"
    },
    "SliceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "size"
      ],
      "title": "SliceRef",
      "type": "object"
    },
    "ThresholdKind": {
      "enum": [
        "relative_drop",
        "absolute_drop",
        "attack_success_rate"
      ],
      "title": "ThresholdKind",
      "type": "string"
    },
    "TrajectoryPoint": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "description": "Thứ tự đánh giá, bắt đầu từ 0, liên tục",
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "level": {
          "title": "Level",
          "type": "number"
        },
        "scope": {
          "$ref": "#/$defs/EvalScope"
        },
        "drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Đại lượng so với ngưỡng (theo metric_kind); null khi run không có metric",
          "title": "Drop"
        },
        "drop_ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Phase 7: khoảng tin cậy bootstrap 95%; chỉ điểm toàn slice, null khi chưa tính hoặc bootstrap_samples = 0",
          "title": "Drop Ci"
        },
        "synthetic": {
          "default": false,
          "description": "Phase 7: level \"không biến đổi\" của spec (eps = 0, tỉ lệ che = 0): drop = 0 theo định nghĩa, không chạy, không có run",
          "title": "Synthetic",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi và chỉ khi synthetic",
          "title": "Run Id"
        }
      },
      "required": [
        "order",
        "level",
        "scope",
        "drop",
        "run_id"
      ],
      "title": "TrajectoryPoint",
      "type": "object"
    },
    "UserRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "full_name": {
          "title": "Full Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "full_name"
      ],
      "title": "UserRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "owner": {
