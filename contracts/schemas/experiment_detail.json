{
  "$defs": {
    "AttackConfig": {
      "additionalProperties": false,
      "description": "Một attack trong experiment.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "spec_sha256": {
          "description": "Chốt đúng version spec",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Sha256",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RunMode"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "training_slice_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 6: bắt buộc khi spec có requires_training; không giao với slice đánh giá",
          "title": "Training Slice Id"
        }
      },
      "required": [
        "attack_spec_id",
        "spec_sha256",
        "mode",
        "seed"
      ],
      "title": "AttackConfig",
      "type": "object"
    },
    "AttackKind": {
      "enum": [
        "attack",
        "corruption",
        "occlusion"
      ],
      "title": "AttackKind",
      "type": "string"
    },
    "AttackRankingEntry": {
      "additionalProperties": false,
      "description": "Một attack trong bảng xếp hạng (Phase 6, `ml_core/metrics/ranking.py`).\n\nĐiểm của đường cong: (level / primary_param.max, relative_drop), thêm (0, 0) ở đầu; level bị\n`early_stop` lấy relative_drop của run kích hoạt. Diện tích tính đến `coverage`, không ngoại\nsuy.",
      "properties": {
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AttackKind"
        },
        "auc_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Diện tích hình thang; null khi ít hơn 2 điểm (không đủ dữ liệu)",
          "title": "Auc Drop"
        },
        "max_relative_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi không có level nào có metric",
          "title": "Max Relative Drop"
        },
        "levels_evaluated": {
          "description": "Số level có metric",
          "minimum": 0,
          "title": "Levels Evaluated",
          "type": "integer"
        },
        "levels_early_stopped": {
          "description": "Số level bị bỏ qua do dừng sớm",
          "minimum": 0,
          "title": "Levels Early Stopped",
          "type": "integer"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "level / max lớn nhất được tính (có metric hoặc early_stop); null khi không có",
          "title": "Coverage"
        },
        "partial": {
          "description": "Có run stopped_limit hoặc metrics.partial",
          "title": "Partial",
          "type": "boolean"
        }
      },
      "required": [
        "attack_spec_id",
        "name",
        "kind",
        "auc_drop",
        "max_relative_drop",
        "levels_evaluated",
        "levels_early_stopped",
        "coverage",
        "partial"
      ],
      "title": "AttackRankingEntry",
      "type": "object"
    },
    "CaseSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "acceptable"
      ],
      "title": "CaseSeverity",
      "type": "string"
    },
    "CaseVerdictKind": {
      "description": "Loại verdict của một failure case (Phase 8).",
      "enum": [
        "safety_relevant",
        "acceptable",
        "annotation_issue"
      ],
      "title": "CaseVerdictKind",
      "type": "string"
    },
    "CaseVerdictView": {
      "additionalProperties": false,
      "description": "Một version verdict; version lớn nhất là hiện hành, mọi version được giữ.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/CaseSeverity"
        },
        "kind": {
          "$ref": "#/$defs/CaseVerdictKind"
        },
        "mitigation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bắt buộc khi kind = safety_relevant",
          "title": "Mitigation"
        },
        "failure_case_id": {
          "format": "uuid",
          "title": "Failure Case Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "reviewer": {
          "$ref": "#/$defs/UserRef"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "failure_case_id",
        "version",
        "reviewer",
        "created_at"
      ],
      "title": "CaseVerdictView",
      "type": "object"
    },
    "ChecklistCode": {
      "description": "Điều kiện trạng thái phía server trước khi chấp nhận (Phase 8, kickoff: chỉ gồm điều kiện\ntrạng thái; trường nhập thiếu là 422, sai người là 403).",
      "enum": [
        "protocol_not_dev",
        "required_cases_reviewed"
      ],
      "title": "ChecklistCode",
      "type": "string"
    },
    "ChecklistItem": {
      "additionalProperties": false,
      "description": "Một điều kiện trạng thái trước khi chấp nhận (Phase 8).",
      "properties": {
        "code": {
          "$ref": "#/$defs/ChecklistCode"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "satisfied",
        "detail"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "ComplianceCode": {
      "description": "Mục kiểm tra tuân thủ protocol khi ước lượng, tạo experiment và gửi duyệt (Phase 8).",
      "enum": [
        "protocol_active",
        "attack_present",
        "spec_sha256",
        "mode",
        "grid_levels",
        "search_threshold",
        "search_range",
        "search_tol",
        "search_bootstrap",
        "min_slice_size",
        "model_gradients"
      ],
      "title": "ComplianceCode",
      "type": "string"
    },
    "ComplianceItem": {
      "additionalProperties": false,
      "description": "Một mục tuân thủ protocol (Phase 8): trong ước lượng, ExperimentDetail và lỗi 422\n`not_compliant` khi tạo experiment.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ComplianceCode"
        },
        "attack_spec_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Attack bắt buộc của mục này; null với mục không theo attack",
          "title": "Attack Spec Name"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "satisfied",
        "detail"
      ],
      "title": "ComplianceItem",
      "type": "object"
    },
    "ComputeKind": {
      "enum": [
        "local",
        "rented"
      ],
      "title": "ComputeKind",
      "type": "string"
    },
    "ComputeTargetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComputeKind"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "ComputeTargetRef",
      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "description": "Kết quả tự động (chỉ tham khảo) của `pass_criteria[index]`.",
      "properties": {
        "index": {
          "description": "Chỉ số trong body.pass_criteria của protocol",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/CriterionStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "max_drop_at_level: đại lượng tại level; min_breaking_point: điểm gãy (cận trên bracket); null khi không có",
          "title": "Value"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "index",
        "status",
        "value",
        "detail"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "CriterionStatus": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "CriterionStatus",
      "type": "string"
    },
    "DisplayMode": {
      "description": "Cách hiển thị ảnh failure case (Phase 5; Phase 6 thêm làm mờ theo từng case).",
      "enum": [
        "normal",
        "hidden_unanonymized",
        "dev_unblurred"
      ],
      "title": "DisplayMode",
      "type": "string"
    },
    "EvalScope": {
      "description": "Tập ảnh mà run đánh giá (Phase 7).",
      "enum": [
        "full",
        "subset"
      ],
      "title": "EvalScope",
      "type": "string"
    },
    "ExperimentConfig": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "protocol_id": {
          "format": "uuid",
          "title": "Protocol Id",
          "type": "string"
        },
        "model_version_id": {
          "format": "uuid",
          "title": "Model Version Id",
          "type": "string"
        },
        "slice_id": {
          "format": "uuid",
          "title": "Slice Id",
          "type": "string"
        },
        "class_mapping_id": {
          "format": "uuid",
          "title": "Class Mapping Id",
          "type": "string"
        },
        "compute_target_id": {
          "format": "uuid",
          "title": "Compute Target Id",
          "type": "string"
        },
        "attacks": {
          "items": {
            "$ref": "#/$defs/AttackConfig"
          },
          "minItems": 1,
          "title": "Attacks",
          "type": "array"
        },
        "limit": {
          "$ref": "#/$defs/Limit"
        }
      },
      "required": [
        "protocol_id",
        "model_version_id",
        "slice_id",
        "class_mapping_id",
        "compute_target_id",
        "attacks",
        "limit"
      ],
      "title": "ExperimentConfig",
      "type": "object"
    },
    "ExperimentStatus": {
      "enum": [
        "draft",
        "queued",
        "running",
        "completed",
        "submitted_for_review",
        "in_review",
        "approved",
        "changes_requested",
        "rejected",
        "cancelled"
      ],
      "title": "ExperimentStatus",
      "type": "string"
    },
    "GridConfig": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Levels",
          "type": "array"
        },
        "early_stop": {
          "description": "Phase 6: bỏ level lớn hơn khi model đã sụp (mAP@0.5 <= 5% mAP sạch)",
          "title": "Early Stop",
          "type": "boolean"
        }
      },
      "required": [
        "levels"
      ],
      "title": "GridConfig",
      "type": "object"
    },
    "Limit": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/LimitKind"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Tiền (budget) hoặc giây (time)",
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Limit",
      "type": "object"
    },
    "LimitKind": {
      "enum": [
        "budget",
        "time"
      ],
      "title": "LimitKind",
      "type": "string"
    },
    "MapPair": {
      "additionalProperties": false,
      "properties": {
        "map50": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50",
          "type": "number"
        },
        "map50_95": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50 95",
          "type": "number"
        }
      },
      "required": [
        "map50",
        "map50_95"
      ],
      "title": "MapPair",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "ID của model version",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ModelVerdict": {
      "description": "Kết luận của reviewer về model; tách khỏi quyết định chấp nhận bài test (Phase 8).",
      "enum": [
        "meets_criteria",
        "does_not_meet",
        "conditional"
      ],
      "title": "ModelVerdict",
      "type": "string"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "images_done": {
          "minimum": 0,
          "title": "Images Done",
          "type": "integer"
        },
        "images_total": {
          "minimum": 0,
          "title": "Images Total",
          "type": "integer"
        }
      },
      "required": [
        "images_done",
        "images_total"
      ],
      "title": "Progress",
      "type": "object"
    },
    "ProtocolRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ProtocolStatus"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "title": "ProtocolRef",
      "type": "object"
    },
    "ProtocolStatus": {
      "enum": [
        "active",
        "retired",
        "dev"
      ],
      "title": "ProtocolStatus",
      "type": "string"
    },
    "ReportStatus": {
      "enum": [
        "generating",
        "ready",
        "failed"
      ],
      "title": "ReportStatus",
      "type": "string"
    },
    "ReportView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "experiment_id": {
          "format": "uuid",
          "title": "Experiment Id",
          "type": "string"
        },
        "experiment_name": {
          "title": "Experiment Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        },
        "model_verdict": {
          "$ref": "#/$defs/ModelVerdict"
        },
        "approved_by": {
          "$ref": "#/$defs/UserRef"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Có khi và chỉ khi status = ready",
          "title": "Generated At"
        },
        "json_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Có khi và chỉ khi status = ready",
          "title": "Json Sha256"
        },
        "pdf_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Có khi và chỉ khi status = ready",
          "title": "Pdf Sha256"
        }
      },
      "required": [
        "id",
        "experiment_id",
        "experiment_name",
        "status",
        "model_verdict",
        "approved_by",
        "approved_at",
        "generated_at",
        "json_sha256",
        "pdf_sha256"
      ],
      "title": "ReportView",
      "type": "object"
    },
    "RequiredCase": {
      "additionalProperties": false,
      "description": "Case bắt buộc review: top `cases_to_review_per_attack` theo `severity_score` của mỗi\nattack bắt buộc (cùng điểm theo `image_id`).",
      "properties": {
        "failure_case_id": {
          "format": "uuid",
          "title": "Failure Case Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "attack_spec_name": {
          "title": "Attack Spec Name",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "number"
        },
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "severity_score": {
          "exclusiveMinimum": 0,
          "title": "Severity Score",
          "type": "number"
        },
        "display_mode": {
          "$ref": "#/$defs/DisplayMode"
        },
        "current_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseVerdictView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "failure_case_id",
        "run_id",
        "attack_spec_name",
        "level",
        "image_id",
        "severity_score",
        "display_mode",
        "current_verdict"
      ],
      "title": "RequiredCase",
      "type": "object"
    },
    "ReviewDecision": {
      "enum": [
        "approve",
        "changes_requested",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewView": {
      "additionalProperties": false,
      "description": "Trạng thái review của experiment (`ExperimentDetail.review`).",
      "properties": {
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "submission_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Submission Note"
        },
        "run_explanations": {
          "items": {
            "$ref": "#/$defs/RunExplanation"
          },
          "title": "Run Explanations",
          "type": "array"
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Người đang nhận hoặc đã quyết định"
        },
        "claimed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Claimed At"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decided At"
        },
        "model_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "conclusion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conclusion"
        },
        "mitigation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mitigation"
        },
        "inconclusive_justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inconclusive Justification"
        },
        "criteria_results": {
