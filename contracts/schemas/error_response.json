{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FieldError"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chỉ có ở lỗi 422 gắn được với trường cụ thể; không có thì bỏ khỏi body",
          "title": "Fields"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "not_implemented",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "invalid_request",
        "invalid_credentials",
        "account_pending",
        "account_rejected",
        "account_disabled",
        "rate_limited",
        "csrf_failed",
        "validation_error",
        "not_supported_yet",
        "queue_limit_reached",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FieldError": {
      "additionalProperties": false,
      "description": "Lỗi của một trường (Phase 5): giao diện hiển thị tại đúng bước và đúng trường.",
      "properties": {
        "path": {
          "description": "Đường dẫn trường trong body, các đoạn ngăn bởi dấu chấm, chỉ số mảng từ 0",
          "examples": [
            "attacks.0.grid.levels"
          ],
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "title": "FieldError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Body lỗi thống nhất của mọi endpoint: {\"error\": {\"code\", \"message\"}}.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
