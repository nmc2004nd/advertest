{
  "$defs": {
    "CaseAnonymization": {
      "additionalProperties": false,
      "description": "Làm mờ mặt người và biển số trên ảnh hiển thị của failure case (Phase 6).",
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "method": {
          "examples": [
            "rule_v1"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Method",
          "type": "string"
        },
        "version": {
          "description": "Version cài đặt của method",
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "regions_count": {
          "description": "Số vùng đã làm mờ trên ảnh",
          "minimum": 0,
          "title": "Regions Count",
          "type": "integer"
        }
      },
      "required": [
        "applied",
        "method",
        "version",
        "regions_count"
      ],
      "title": "CaseAnonymization",
      "type": "object"
    },
    "CaseArtifacts": {
      "additionalProperties": false,
      "description": "Khóa lưu trữ (LocalStore ở Phase 2, MinIO từ Phase 3) của ảnh PNG letterbox.",
      "properties": {
        "clean_png": {
          "minLength": 1,
          "title": "Clean Png",
          "type": "string"
        },
        "adversarial_png": {
          "minLength": 1,
          "title": "Adversarial Png",
          "type": "string"
        },
        "perturbation_png": {
          "description": "Ảnh thứ ba; nội dung theo FailureCaseRecord.perturbation_kind",
          "minLength": 1,
          "title": "Perturbation Png",
          "type": "string"
        },
        "clean_thumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thumbnail WebP rộng 320 px (Phase 3); null khi chạy bằng CLI, bắt buộc qua worker",
          "title": "Clean Thumb"
        },
        "adversarial_thumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thumbnail WebP rộng 320 px (Phase 3); null khi chạy bằng CLI, bắt buộc qua worker",
          "title": "Adversarial Thumb"
        }
      },
      "required": [
        "clean_png",
        "adversarial_png",
        "perturbation_png"
      ],
      "title": "CaseArtifacts",
      "type": "object"
    },
    "CaseBox": {
      "additionalProperties": false,
      "description": "Box trong failure case: xyxy pixel trong không gian letterbox.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "class_name": {
          "description": "Class đích của mapping",
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null với ground truth, bắt buộc với prediction",
          "title": "Score"
        }
      },
      "required": [
        "bbox",
        "class_name",
        "score"
      ],
      "title": "CaseBox",
      "type": "object"
    },
    "CaseDetections": {
      "additionalProperties": false,
      "properties": {
        "ground_truth": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Ground Truth",
          "type": "array"
        },
        "clean": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Clean",
          "type": "array"
        },
        "attacked": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Attacked",
          "type": "array"
        },
        "ignore_regions": {
          "items": {
            "$ref": "#/$defs/CaseIgnoreRegion"
          },
          "title": "Ignore Regions",
          "type": "array"
        }
      },
      "required": [
        "ground_truth",
        "clean",
        "attacked",
        "ignore_regions"
      ],
      "title": "CaseDetections",
      "type": "object"
    },
    "CaseIgnoreRegion": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "description": "xyxy pixel trong không gian letterbox",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "source": {
          "pattern": "^(dont_care|unmapped:.+|difficulty:.+)$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "bbox",
        "source"
      ],
      "title": "CaseIgnoreRegion",
      "type": "object"
    },
    "PerturbationImageKind": {
      "description": "Nội dung ảnh thứ ba của failure case (Phase 6).",
      "enum": [
        "amplified_noise",
        "difference",
        "patch_location"
      ],
      "title": "PerturbationImageKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Một ảnh bị attack làm hỏng nặng trong một run (Phase 2).",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "compute_failure_case_id(fingerprint, run_id, image_id)",
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "fingerprint": {
      "description": "Fingerprint của run",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "image_id": {
      "minLength": 1,
      "title": "Image Id",
      "type": "string"
    },
    "lost_objects": {
      "description": "Số object bị mất sau tấn công",
      "minimum": 0,
      "title": "Lost Objects",
      "type": "integer"
    },
    "new_false_positives": {
      "description": "Số detection sai mới xuất hiện",
      "minimum": 0,
      "title": "New False Positives",
      "type": "integer"
    },
    "severity_score": {
      "description": "lost_objects + 0.5 * new_false_positives; chỉ lưu case > 0",
      "exclusiveMinimum": 0,
      "title": "Severity Score",
      "type": "number"
    },
    "detections": {
      "$ref": "#/$defs/CaseDetections"
    },
    "artifacts": {
      "$ref": "#/$defs/CaseArtifacts"
    },
    "perturbation_kind": {
      "$ref": "#/$defs/PerturbationImageKind",
      "default": "amplified_noise",
      "description": "Phase 6: nhiễu khuếch đại (FGSM, PGD), vùng khác biệt (corruption, occlusion) hoặc vị trí patch"
    },
    "anonymization": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseAnonymization"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "null với case tạo trước Phase 6 (ảnh chưa làm mờ); case mới luôn có"
    }
  },
  "required": [
    "id",
    "run_id",
    "fingerprint",
    "image_id",
    "lost_objects",
    "new_false_positives",
    "severity_score",
    "detections",
    "artifacts"
  ],
  "title": "FailureCaseRecord",
  "type": "object"
}
