{
  "$defs": {
    "CaseAnonymization": {
      "additionalProperties": false,
      "description": "Làm mờ mặt người và biển số trên ảnh hiển thị của failure case (Phase 6).",
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "method": {
          "examples": [
            "rule_v1"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Method",
          "type": "string"
        },
        "version": {
          "description": "Version cài đặt của method",
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "regions_count": {
          "description": "Số vùng đã làm mờ trên ảnh",
          "minimum": 0,
          "title": "Regions Count",
          "type": "integer"
        }
      },
      "required": [
        "applied",
        "method",
        "version",
        "regions_count"
      ],
      "title": "CaseAnonymization",
      "type": "object"
    },
    "CaseArtifacts": {
      "additionalProperties": false,
      "description": "Khóa lưu trữ (LocalStore ở Phase 2, MinIO từ Phase 3) của ảnh PNG letterbox.",
      "properties": {
        "clean_png": {
          "minLength": 1,
          "title": "Clean Png",
          "type": "string"
        },
        "adversarial_png": {
          "minLength": 1,
          "title": "Adversarial Png",
          "type": "string"
        },
        "perturbation_png": {
          "description": "Ảnh thứ ba; nội dung theo FailureCaseRecord.perturbation_kind",
          "minLength": 1,
          "title": "Perturbation Png",
          "type": "string"
        },
        "clean_thumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thumbnail WebP rộng 320 px (Phase 3); null khi chạy bằng CLI, bắt buộc qua worker",
          "title": "Clean Thumb"
        },
        "adversarial_thumb": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Thumbnail WebP rộng 320 px (Phase 3); null khi chạy bằng CLI, bắt buộc qua worker",
          "title": "Adversarial Thumb"
        }
      },
      "required": [
        "clean_png",
        "adversarial_png",
        "perturbation_png"
      ],
      "title": "CaseArtifacts",
      "type": "object"
    },
    "CaseBox": {
      "additionalProperties": false,
      "description": "Box trong failure case: xyxy pixel trong không gian letterbox.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "class_name": {
          "description": "Class đích của mapping",
          "minLength": 1,
          "title": "Class Name",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null với ground truth, bắt buộc với prediction",
          "title": "Score"
        }
      },
      "required": [
        "bbox",
        "class_name",
        "score"
      ],
      "title": "CaseBox",
      "type": "object"
    },
    "CaseDetections": {
      "additionalProperties": false,
      "properties": {
        "ground_truth": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Ground Truth",
          "type": "array"
        },
        "clean": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Clean",
          "type": "array"
        },
        "attacked": {
          "items": {
            "$ref": "#/$defs/CaseBox"
          },
          "title": "Attacked",
          "type": "array"
        },
        "ignore_regions": {
          "items": {
            "$ref": "#/$defs/CaseIgnoreRegion"
          },
          "title": "Ignore Regions",
          "type": "array"
        }
      },
      "required": [
        "ground_truth",
        "clean",
        "attacked",
        "ignore_regions"
      ],
      "title": "CaseDetections",
      "type": "object"
    },
    "CaseIgnoreRegion": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "description": "xyxy pixel trong không gian letterbox",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "source": {
          "pattern": "^(dont_care|unmapped:.+|difficulty:.+)$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "bbox",
        "source"
      ],
      "title": "CaseIgnoreRegion",
      "type": "object"
    },
    "ClassRunMetrics": {
      "additionalProperties": false,
      "properties": {
        "clean_ap50": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Clean Ap50"
        },
        "attacked_ap50": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attacked Ap50"
        },
        "attack_success_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 7: ASR chỉ tính object của class này (ngưỡng có class_filter); null khi không có object nào của class được detect đúng trên ảnh sạch, hoặc run trước Phase 7",
          "title": "Attack Success Rate"
        }
      },
      "required": [
        "clean_ap50",
        "attacked_ap50"
      ],
      "title": "ClassRunMetrics",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Cost",
      "type": "object"
    },
    "EvalScope": {
      "description": "Tập ảnh mà run đánh giá (Phase 7).",
      "enum": [
        "full",
        "subset"
      ],
      "title": "EvalScope",
      "type": "string"
    },
    "FailureCaseRecord": {
      "additionalProperties": false,
      "description": "Một ảnh bị attack làm hỏng nặng trong một run (Phase 2).",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "description": "compute_failure_case_id(fingerprint, run_id, image_id)",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "fingerprint": {
          "description": "Fingerprint của run",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "lost_objects": {
          "description": "Số object bị mất sau tấn công",
          "minimum": 0,
          "title": "Lost Objects",
          "type": "integer"
        },
        "new_false_positives": {
          "description": "Số detection sai mới xuất hiện",
          "minimum": 0,
          "title": "New False Positives",
          "type": "integer"
        },
        "severity_score": {
          "description": "lost_objects + 0.5 * new_false_positives; chỉ lưu case > 0",
          "exclusiveMinimum": 0,
          "title": "Severity Score",
          "type": "number"
        },
        "detections": {
          "$ref": "#/$defs/CaseDetections"
        },
        "artifacts": {
          "$ref": "#/$defs/CaseArtifacts"
        },
        "perturbation_kind": {
          "$ref": "#/$defs/PerturbationImageKind",
          "default": "amplified_noise",
          "description": "Phase 6: nhiễu khuếch đại (FGSM, PGD), vùng khác biệt (corruption, occlusion) hoặc vị trí patch"
        },
        "anonymization": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseAnonymization"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null với case tạo trước Phase 6 (ảnh chưa làm mờ); case mới luôn có"
        }
      },
      "required": [
        "id",
        "run_id",
        "fingerprint",
        "image_id",
        "lost_objects",
        "new_false_positives",
        "severity_score",
        "detections",
        "artifacts"
      ],
      "title": "FailureCaseRecord",
      "type": "object"
    },
    "MapPair": {
      "additionalProperties": false,
      "properties": {
        "map50": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50",
          "type": "number"
        },
        "map50_95": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map50 95",
          "type": "number"
        }
      },
      "required": [
        "map50",
        "map50_95"
      ],
      "title": "MapPair",
      "type": "object"
    },
    "PerturbationImageKind": {
      "description": "Nội dung ảnh thứ ba của failure case (Phase 6).",
      "enum": [
        "amplified_noise",
        "difference",
        "patch_location"
      ],
      "title": "PerturbationImageKind",
      "type": "string"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "images_done": {
          "minimum": 0,
          "title": "Images Done",
          "type": "integer"
        },
        "images_total": {
          "minimum": 0,
          "title": "Images Total",
          "type": "integer"
        }
      },
      "required": [
        "images_done",
        "images_total"
      ],
      "title": "Progress",
      "type": "object"
    },
    "RunMetrics": {
      "additionalProperties": false,
      "properties": {
        "clean": {
          "$ref": "#/$defs/MapPair"
        },
        "attacked": {
          "$ref": "#/$defs/MapPair"
        },
        "relative_drop": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi mAP@0.5 sạch bằng 0",
          "title": "Relative Drop"
        },
        "absolute_drop": {
          "title": "Absolute Drop",
          "type": "number"
        },
        "attack_success_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null khi không có object nào được detect đúng trên ảnh sạch (|C| = 0)",
          "title": "Attack Success Rate"
        },
        "per_class": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ClassRunMetrics"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Class"
        },
        "partial": {
          "default": false,
          "description": "true khi metric chỉ tính trên phần ảnh đã xử lý (stopped_limit)",
          "title": "Partial",
          "type": "boolean"
        }
      },
      "required": [
        "clean",
        "attacked",
        "relative_drop",
        "absolute_drop",
        "attack_success_rate"
      ],
      "title": "RunMetrics",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "experiment_id": {
          "format": "uuid",
          "title": "Experiment Id",
          "type": "string"
        },
        "attack_spec_id": {
          "format": "uuid",
          "title": "Attack Spec Id",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "status_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatusReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "progress": {
          "$ref": "#/$defs/Progress"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gpu_seconds": {
          "minimum": 0,
          "title": "Gpu Seconds",
          "type": "number"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cost"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null với máy local"
        },
        "failure_case_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Failure Case Ids",
          "type": "array"
        },
        "manifest_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Uri"
        },
        "cached_from_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Run gốc khi status = skipped với code = cached (Phase 3)",
          "title": "Cached From Run Id"
        },
        "scope": {
          "$ref": "#/$defs/EvalScope",
          "description": "Phase 7: tập ảnh được đánh giá; subset chỉ có ở run của tìm ngưỡng"
        },
        "search_order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 7: thứ tự điểm trong lần tìm ngưỡng của attack (TrajectoryPoint.order); null với run quét lưới",
          "title": "Search Order"
        },
        "predictions_key": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 7: khóa file prediction theo ảnh trong runs/<run_id>/ (bootstrap); run trúng cache có bản sao file của run gốc (đề xuất contract 001); null khi chưa có metric, run trước Phase 7, hoặc run gốc không có file",
          "title": "Predictions Key"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "experiment_id",
        "attack_spec_id",
        "level",
        "status",
        "progress",
        "gpu_seconds",
        "failure_case_ids",
        "fingerprint"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "skipped",
        "stopped_limit",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SkipReason": {
      "enum": [
        "cached",
        "incompatible",
        "early_stop"
      ],
      "title": "SkipReason",
      "type": "string"
    },
    "StatusReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopReason"
            },
            {
              "$ref": "#/$defs/SkipReason"
            },
            {
              "enum": [
                "error",
                "cancelled"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "trigger_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 6: run đã kích hoạt dừng sớm; có khi và chỉ khi code = early_stop",
          "title": "Trigger Run Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StatusReason",
      "type": "object"
    },
    "StopReason": {
      "enum": [
        "budget",
        "time"
      ],
      "title": "StopReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Body của `POST /runs/{id}/complete`.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "run_result": {
      "$ref": "#/$defs/RunResult"
    },
    "failure_cases": {
      "items": {
        "$ref": "#/$defs/FailureCaseRecord"
      },
      "title": "Failure Cases",
      "type": "array"
    }
  },
  "required": [
    "lease_id",
    "run_result",
    "failure_cases"
  ],
  "title": "RunCompletion",
  "type": "object"
}
