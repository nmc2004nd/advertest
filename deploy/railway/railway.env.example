# Biến môi trường trên Railway (dán vào tab Variables → Raw Editor của từng service).
# ${{...}} là biến tham chiếu của Railway. Không commit giá trị thật.
# Mật khẩu và khóa chỉ dùng chữ và số (được ghép vào URL), ví dụ: openssl rand -hex 24

# ===== Shared Variables (Project Settings → Shared Variables) =====
ADVERTEST_OWNER_PASSWORD=
ADVERTEST_APP_PASSWORD=
ARTIFACT_TOKEN_SECRET=

# ===== Service api =====
PORT=8000
# 0.0.0.0: healthcheck của Railway đi bằng IPv4; "::" của uvicorn chỉ nhận IPv6. Mạng riêng của
# environment mới có IPv4. GIT_COMMIT tự lấy từ RAILWAY_GIT_COMMIT_SHA (docker/api/entrypoint.sh).
API_HOST=0.0.0.0
MIGRATION_DATABASE_URL=postgresql+psycopg://advertest_owner:${{shared.ADVERTEST_OWNER_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/advertest
DATABASE_URL=postgresql+psycopg://advertest_app:${{shared.ADVERTEST_APP_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/advertest
# Storage Bucket của Railway (service tên `bucket`), API S3. Bucket chỉ có endpoint công khai, nên
# api, worker trên PC và trình duyệt dùng chung một endpoint (không cần MINIO_PUBLIC_ENDPOINT).
# Một bucket duy nhất: models/datasets/artifacts/reports thành tiền tố khóa trong đó.
MINIO_ENDPOINT=${{bucket.ENDPOINT}}
MINIO_BUCKET=${{bucket.BUCKET}}
# Region ký S3 là "auto" (tab Credentials), không phải ${{bucket.REGION}} (đó là vị trí, ví dụ sin).
MINIO_REGION=auto
# Theo tab Credentials của bucket: "virtual" (mặc định của bucket mới) hoặc "path".
MINIO_ADDRESSING_STYLE=virtual
MINIO_ACCESS_KEY=${{bucket.ACCESS_KEY_ID}}
MINIO_SECRET_KEY=${{bucket.SECRET_ACCESS_KEY}}
ARTIFACT_TOKEN_SECRET=${{shared.ARTIFACT_TOKEN_SECRET}}
COOKIE_SECURE=true
# API không có domain công khai: chỉ Caddy (service frontend) gọi tới, và Caddy chỉ gửi một giá trị
# X-Forwarded-For lấy từ X-Real-IP của Railway. KHÔNG tạo public domain cho api khi đặt "*".
TRUSTED_PROXIES=*
APP_BASE_URL=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
DEV_ALLOW_UNBLURRED=false
# SMTP để trống thì email nằm chờ trong outbox. Có dịch vụ SMTP (Resend, Brevo...) thì điền.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=AdverTest <no-reply@example.com>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Nhận xét bằng LLM; trống thì ẩn.
LLM_API_KEY=

# ===== Service frontend =====
PORT=8080
API_UPSTREAM=${{api.RAILWAY_PRIVATE_DOMAIN}}:8000
