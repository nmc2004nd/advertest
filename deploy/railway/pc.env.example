# Biến môi trường trên PC (worker + lệnh quản trị trỏ vào Railway).
# Chép thành .env.pc ở gốc repo (đã gitignore): cp deploy/railway/pc.env.example .env.pc

# ---- Worker (deploy/railway/pc-up.sh) ----
# Domain của service frontend + /api (worker gọi <API_URL>/internal/worker/...).
API_URL=https://FRONTEND_DOMAIN/api
# Token của compute target (in ra khi tạo bằng advertest-admin compute-target create).
WORKER_TOKEN=
WORKER_TOOLS_TOKEN=
# Để trống: GPU nếu có, không thì CPU.
WORKER_DEVICE=

# ---- Lệnh quản trị chạy trên PC (seed admin, tạo compute target, import-local) ----
# Postgres: lấy host/cổng TCP proxy ở service Postgres → Settings → Networking → Public Networking.
PGHOST=PROXY_HOST.proxy.rlwy.net
PGPORT=PROXY_PORT
# Mật khẩu superuser của Postgres trên Railway (biến PGPASSWORD của service Postgres); chỉ dùng cho init-db.sh.
PGPASSWORD=
ADVERTEST_OWNER_PASSWORD=
ADVERTEST_APP_PASSWORD=
DATABASE_URL=postgresql+psycopg://advertest_app:APP_PASSWORD@PROXY_HOST.proxy.rlwy.net:PROXY_PORT/advertest
# Bucket: chép từ tab Credentials của service `bucket` trên Railway (ENDPOINT, BUCKET, REGION,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY). Worker không dùng các biến này, chỉ lệnh quản trị và
# bucket-cors.sh.
MINIO_ENDPOINT=https://t3.storageapi.dev
MINIO_BUCKET=
MINIO_REGION=auto
MINIO_ADDRESSING_STYLE=virtual
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Domain của service frontend (origin được phép PUT lên bucket, cho bucket-cors.sh).
APP_BASE_URL=https://FRONTEND_DOMAIN

ADVERTEST_ADMIN_EMAIL=
ADVERTEST_ADMIN_PASSWORD=
