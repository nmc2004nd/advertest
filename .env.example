# Biến môi trường của AdverTest. Chép vào .env (không commit) và thay mọi giá trị "change-me".
# Mật khẩu và khóa chỉ dùng chữ và số: chúng được ghép vào URL kết nối.

# ---- Postgres (docker/compose.yaml) ----
POSTGRES_PASSWORD=change-me-postgres
# Role chạy migration, sở hữu bảng.
ADVERTEST_OWNER_PASSWORD=change-me-owner
# Role ứng dụng dùng khi chạy (không có UPDATE/DELETE trên bảng chỉ-thêm).
ADVERTEST_APP_PASSWORD=change-me-app

# URL khi chạy ngoài Docker (make migrate, script seed). Trong Compose, URL được ghép tự động.
MIGRATION_DATABASE_URL=postgresql+psycopg://advertest_owner:change-me-owner@127.0.0.1:5432/advertest
DATABASE_URL=postgresql+psycopg://advertest_app:change-me-app@127.0.0.1:5432/advertest

# ---- MinIO ----
MINIO_ACCESS_KEY=advertest
MINIO_SECRET_KEY=change-me-minio-secret
# Chỉ dùng khi chạy API ngoài Docker; trong Compose là http://minio:9000.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host mà worker dùng để gọi presigned URL (chữ ký S3 gồm host). Worker chạy trên máy hoặc
# trong compose (host network) đều gọi 127.0.0.1.
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# ---- API ----
API_PORT=8000
# Commit hiển thị ở /health (image Docker không có .git). Ví dụ: GIT_COMMIT=$(git rev-parse HEAD) make up
GIT_COMMIT=unknown
# Phase 4: true khi phục vụ qua HTTPS (cookie phiên có cờ Secure).
COOKIE_SECURE=false
# Proxy (IP, mạng CIDR, cách nhau bởi dấu phẩy) được tin X-Forwarded-For khi xác định IP của
# client cho giới hạn đăng nhập sai. Thêm IP hoặc mạng của reverse proxy/Vite proxy nếu có.
TRUSTED_PROXIES=127.0.0.1
# Origin của frontend: link đặt lại mật khẩu do admin tạo là {APP_BASE_URL}/reset-password/<token>.
APP_BASE_URL=http://localhost:5173

# ---- Dữ liệu cho advertest-admin import-local (Phase 3) ----
# Đường dẫn tuyệt đối tới thư mục data/ của repo (chứa store/ và ảnh gốc); được mount vào
# container api ở đúng đường dẫn này (chỉ đọc) vì LocalStore ghi đường dẫn tuyệt đối của ảnh.
# ADVERTEST_DATA_DIR=/duong/dan/tuyet/doi/advertest/data

# ---- Worker (Phase 3, docs/van-hanh-worker.md) ----
# Worker gọi API nội bộ bằng token của compute target (in ra khi tạo hoặc rotate-token).
API_URL=http://127.0.0.1:8000
WORKER_TOKEN=
# Để trống: GPU nếu có, không thì CPU. Ví dụ: cpu, cuda:0.
WORKER_DEVICE=
# Cache weights, ảnh, manifest theo sha256 (worker chạy trên máy); mặc định ~/.cache/advertest-worker.
# CACHE_DIR=

# ---- Tài khoản admin đầu tiên (python -m backend.admin_cli.seed) ----
ADVERTEST_ADMIN_EMAIL=admin@example.com
ADVERTEST_ADMIN_PASSWORD=change-me-admin

# ---- Frontend ----
FRONTEND_PORT=5173
# true: đọc dữ liệu từ contracts/mocks thay cho API.
VITE_USE_MOCKS=false
